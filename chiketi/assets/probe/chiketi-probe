#!/bin/sh
# chiketi-probe: read-only health snapshot for chiketi's Home Lab screen.
#
# It runs as the forced command of the chiketi server's key (authorized_keys
# `command="/usr/local/bin/chiketi-probe",restrict`), so it takes no arguments
# and reads no input. It prints key=value lines and changes nothing; the only
# write is a one-hour cache of the apt security-update count in /tmp.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LC_ALL=C
export PATH LC_ALL

# A monotonic clock for the optional last step: whole seconds of /proc/uptime, line 1 only.
UP=${CHIKETI_PROBE_UPTIME:-/proc/uptime}
up() { awk 'NR == 1 && $1 ~ /^[0-9]+(\.[0-9]+)?$/ { print int($1) }' "$UP" 2>/dev/null; }
START_UP=$(up)

echo "probe_version=2"
if [ -r /var/local/emhttp/var.ini ]; then KIND=unraid; else KIND=linux; fi
echo "kind=$KIND"

awk '/^MemTotal:/ {print "mem_total_kb=" $2} /^MemAvailable:/ {print "mem_avail_kb=" $2}' /proc/meminfo

# Real local filesystems only: network and virtual mounts (nfs, virtiofs, fuse,
# tmpfs, overlay) belong to some other host or to nobody.
df -P -T -k 2>/dev/null | awk 'NR > 1 && $2 ~ /^(ext[234]|xfs|btrfs|zfs|vfat|f2fs)$/ {
  pct = $6; sub(/%$/, "", pct); m = $7
  for (i = 8; i <= NF; i++) m = m " " $i
  gsub(/[|=]/, "_", m); print "fs=" m "|" pct }'

best=""
for d in /sys/class/hwmon/hwmon*; do
  n=$(cat "$d/name" 2>/dev/null)
  case "$n" in coretemp|k10temp|zenpower|cpu_thermal) ;; *) continue ;; esac
  for t in "$d"/temp*_input; do
    [ -r "$t" ] || continue
    v=$(cat "$t" 2>/dev/null)
    case "$v" in ''|*[!0-9]*) continue ;; esac
    if [ -z "$best" ] || [ "$v" -gt "$best" ]; then best=$v; fi
  done
done
[ -n "$best" ] && echo "cpu_temp_c=$((best / 1000))"

# GPUs (NVIDIA): one sample, its outcome, and a process COUNT per card. No names,
# no PIDs. Each call is time-boxed where timeout(1) exists: TERM at the limit, KILL
# one second later for a call that ignores TERM (at most 6 + 6 + 5 s in all). The
# memory temperatures are an optional, separately budgeted query at the very end.
nv() {
  nv_s=$1; shift
  if command -v timeout >/dev/null 2>&1; then timeout -k 1 "$nv_s" nvidia-smi "$@"; else nvidia-smi "$@"; fi
}
if command -v nvidia-smi >/dev/null 2>&1; then
  F=index,name,utilization.gpu,memory.used,memory.total,temperature.gpu,power.draw,power.limit,fan.speed
  out=$(nv 5 --query-gpu="$F,clocks_throttle_reasons.active,pci.bus_id,uuid" --format=csv,noheader,nounits 2>/dev/null)
  rc=$?
  if [ "$rc" -ne 0 ] && printf '%s' "$out" | grep -qi 'valid field'; then
    out=$(nv 5 --query-gpu="$F,clocks_event_reasons.active,pci.bus_id,uuid" --format=csv,noheader,nounits 2>/dev/null)
    rc=$?
  fi
  if [ "$rc" -ne 0 ]; then
    echo "gpu_query=fail|$rc"
  else
    NV_OK=1
    echo "gpu_query=ok|$(printf '%s\n' "$out" | grep -c .)"
    printf '%s\n' "$out" | awk -F', ' '
      function num(x) { gsub(/^ +| +$/, "", x); return (x ~ /^-?[0-9]+(\.[0-9]+)?$/) ? x : "" }
      NF {
        if (NF != 12) next
        idx = num($1); if (idx == "" || idx ~ /[.-]/) next
        name = $2; gsub(/[|=]/, "", name); name = substr(name, 1, 40)
        thr = $10; gsub(/ /, "", thr); if (thr !~ /^0x[0-9A-Fa-f]+$/) thr = ""
        bus = $11; gsub(/[|= ]/, "", bus)
        uid = $12; gsub(/[|= ]/, "", uid); uid = substr(uid, 1, 64)
        if (uid !~ /^(GPU|MIG)-[0-9A-Za-z-]+$/) uid = ""
        t = num($6)
        print "gpu=" idx "|" name "|" num($3) "|" num($4) "|" num($5) "|" t "|" num($7) "|" num($8) "|" num($9) "|" thr "|" bus "|" uid
        if (t != "") print "gpu_temp_c=" int(t)
      }'
    pout=$(nv 4 --query-compute-apps=gpu_bus_id --format=csv,noheader 2>/dev/null)
    prc=$?
    if [ "$prc" -ne 0 ]; then
      echo "gpu_procs_query=fail|$prc"
    else
      echo "gpu_procs_query=ok"
      printf '%s\n' "$pout" | awk 'NF { b = $0; gsub(/[|= ]/, "", b); if (b != "") c[b]++ }
        END { for (b in c) print "gpu_procs=" b "|" c[b] }'
    fi
  fi
else
  echo "gpu_tool=absent"
fi

HELPER=/usr/local/lib/chiketi-probe/smart-read
if command -v smartctl >/dev/null 2>&1 && [ -x "$HELPER" ]; then
  if [ "$(id -u)" = 0 ]; then RUN=""; else RUN="sudo -n"; fi
  for dev in $(lsblk -dno NAME,TYPE 2>/dev/null | awk '$2 == "disk" && $1 !~ /^(loop|zram|sr|ram)/ {print $1}'); do
    out=$($RUN "$HELPER" "$dev" 2>/dev/null)
    rc=$?
    # Bit 1: could not open the device, or it is in standby (-n standby). Skip it.
    [ $((rc & 2)) -ne 0 ] && continue
    # Virtual disks (virtio) have no model file: leave the model empty, quietly.
    model=$({ tr -s ' ' < "/sys/block/$dev/device/model"; } 2>/dev/null | sed 's/^ //;s/ $//' | tr -d '|=')
    printf '%s\n' "$out" | awk -v dev="$dev" -v model="$model" '
      /overall-health self-assessment test result:/ { h = $NF }
      /SMART Health Status:/ { h = $NF }
      $1 == "5"   && $2 ~ /Reallocated_Sector/ { r = $10 }
      $1 == "197" && $2 ~ /Current_Pending/    { p = $10 }
      $1 == "198" && $2 ~ /Offline_Uncorrect/  { o = $10 }
      ($1 == "194" || $1 == "190") && t == "" { t = $10 }
      /^Temperature:/ && t == "" { t = $2 }
      END { print "disk=" dev "|" model "|" t "|" r "|" p "|" o "|" h }'
  done
fi

if command -v systemctl >/dev/null 2>&1; then
  f=$(systemctl --failed --no-legend --plain 2>/dev/null | awk 'NF {print $1}')
  n=$(printf '%s\n' "$f" | grep -c .)
  names=$(printf '%s' "$f" | tr '\n' ',' | tr -d '|=' | cut -c1-300)
  echo "failed_units=$n|$names"
fi

if command -v apt-get >/dev/null 2>&1; then
  c=/tmp/chiketi-probe-sec
  if [ -z "$(find "$c" -mmin -60 2>/dev/null)" ]; then
    { apt-get -s -o Debug::NoLocking=1 upgrade 2>/dev/null | grep -c '^Inst .*-security'; true; } > "$c.$$" &&
      mv -f "$c.$$" "$c"
  fi
  [ -r "$c" ] && echo "sec_updates=$(cat "$c")"
fi

if [ "$KIND" = unraid ]; then
  awk -F= '
    $1 == "mdState"    { v = $2; gsub(/"/, "", v); print "unraid_array=" v }
    $1 == "sbSyncErrs" { v = $2; gsub(/"/, "", v); print "unraid_parity_errors=" v }' /var/local/emhttp/var.ini
  # The array as a whole: Unraid fills data disks one after another, so a
  # single full disk is normal and only the total matters.
  df -P -k 2>/dev/null | awk '$6 ~ /^\/mnt\/disk[0-9]+$/ { u += $3; t += $2 }
    END { if (t > 0) printf "unraid_array_pct=%d\n", (u * 100 + t / 2) / t }'
  awk -F= '
    /^\[/ { s = $0; gsub(/[]["]/, "", s) }
    $1 == "status" { v = $2; gsub(/"/, "", v); if (s != "") print "unraid_disk=" s "|" v }' /var/local/emhttp/disks.ini
fi
# Last, and optional: memory (HBM) temperatures. Only where timeout(1) exists, and only
# if the probe has run for under 20 s, so it ends by 24 s and cannot cost the sample.
if [ "${NV_OK:-0}" = 1 ] && command -v timeout >/dev/null 2>&1; then
  now_up=$(up)
  case "$START_UP" in ''|*[!0-9]*) now_up="" ;; esac
  case "$now_up" in
    ''|*[!0-9]*) ;;
    *)
      el=$((now_up - START_UP))
      if [ "$el" -ge 0 ] && [ "$el" -lt 20 ]; then
        mout=$(timeout -k 1 3 nvidia-smi --query-gpu=pci.bus_id,temperature.memory --format=csv,noheader,nounits 2>/dev/null) &&
          printf '%s\n' "$mout" | awk -F', ' 'NF == 2 { b = $1; gsub(/[|= ]/, "", b); t = $2; gsub(/^ +| +$/, "", t)
            if (b != "" && t ~ /^-?[0-9]+(\.[0-9]+)?$/) print "gpu_mem_temp=" b "|" t }'
      fi ;;
  esac
fi
exit 0
