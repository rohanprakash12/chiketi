<!doctype html>
<meta charset="utf-8">
<title>chiketi kiosk</title>
<style>
  html, body { margin: 0; height: 100%; background: #000; overflow: hidden; }
  iframe { position: fixed; top: 0; left: 0; width: 100%; height: 100%; border: 0; }
  #down { position: fixed; top: 0; left: 0; right: 0; bottom: 0; display: none; background: #000; color: #ffb000;
          font: 600 3.2vw/1.4 sans-serif; align-items: center; justify-content: center;
          flex-direction: column; text-align: center; }
  #clock { font-size: 14vw; color: #ccc; }
</style>
<iframe id="f" src="${display_url_attr}"></iframe>
<div id="down"><div id="clock"></div><div id="msg"></div></div>
<script>
/* Generated by chiketi-site. Shows the dashboard, and says so if the chiketi
   server stops answering for 30 s. Recovers on its own. */
var BASE = ${base_js};
var DISPLAY = ${display_url_js};
var lastOk = Date.now(), downSince = null;
function hhmm(t) {
  var d = new Date(t);
  return ('0' + d.getHours()).slice(-2) + ':' + ('0' + d.getMinutes()).slice(-2);
}
function up() {
  if (downSince !== null) {
    downSince = null;
    document.getElementById('down').style.display = 'none';
    document.getElementById('f').src = DISPLAY;
  }
  lastOk = Date.now();
}
function down() {
  if (downSince === null && Date.now() - lastOk > 30000) {
    downSince = lastOk;
    document.getElementById('msg').textContent =
      'Dashboard server unreachable since ' + hhmm(downSince) + '.';
    document.getElementById('down').style.display = 'flex';
  }
}
function check() {
  /* This page is a file:// page, so the request is cross-origin. An opaque
     no-cors fetch resolves on any answer and rejects on none: that is all we need. */
  var timer, done = false;
  function finish(ok) { if (done) return; done = true; clearTimeout(timer); if (ok) up(); else down(); }
  timer = setTimeout(function () { finish(false); }, 5000);
  fetch(BASE + '/api/health', { mode: 'no-cors', cache: 'no-store' })
    .then(function () { finish(true); }, function () { finish(false); });
}
setInterval(function () { document.getElementById('clock').textContent = hhmm(Date.now()); }, 1000);
setInterval(check, 10000);
check();
</script>
